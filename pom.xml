<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        DSI REST Federator — aggregator.

        Builds nothing itself; it orders the modules and holds the dependency
        versions they share. `mvn clean verify` here builds all five in
        dependency order.

          common/                  plumbing shared by the gateway and the client
          server/                  the gateway (deployed as a container)
          client/                  importable library jar for consumers
          demo/demo-runner-server  example backend the gateway proxies to
          demo/demo-runner-client  example consumer importing the client jar

        The demo modules are illustrative only and are not part of the
        federator; they have their own CI and CD pipelines.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
            Bumped from 3.5.16 (Spring Framework 6.2.x) to clear CVE-2026-59313
            on spring-webmvc, which JFrog only lists a 7.0.9 fix for — no 6.2.x
            backport was found. Spring Framework 7.x requires Spring Boot 4.x.

            Further bumped from 4.0.0 to 4.0.7 on 10 Sep 2026, per a Checkmarx
            SCA scan that found spring-boot/-autoconfigure/-security/-actuator*
            at 4.0.0 still carrying: CVE-2026-22731 (actuator health-group auth
            bypass, fixed 4.0.4+), CVE-2026-40971/40973/40974/40975 (hostname
            verification / predictable temp dir, fixed 4.0.6+), and
            CVE-2026-41001 (predictable Artemis broker path, affects "4.0.0
            through 4.0.6" — needs 4.0.7). This single parent bump is expected
            to resolve all of these, since they are Spring Boot's own release
            versions, not independently overridable properties the way
            spring-framework/-security/tomcat/jackson are below.

            CONFIRM this is still the correct/latest 4.x patch version before
            merging — check spring.io/projects/spring-boot#support directly;
            this value could not be verified against a live Maven repository
            from this environment (no network access).
        -->
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>org.dsi.dpn</groupId>
    <artifactId>rest-federator-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>DSI REST Federator — Parent</name>

    <description>
        Aggregator for the DSI REST Federator: the gateway, the consumer client
        library, their shared plumbing, and the example demo applications.
    </description>

    <modules>
        <module>common</module>
        <module>server</module>
        <module>client</module>
        <module>demo/demo-runner-server</module>
        <module>demo/demo-runner-client</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.38</lombok.version>
        <!--
            Spring Boot 4.0.0's own dependency management pulls in Spring
            Framework 7.0.1 - confirmed via a Checkmarx SCA scan on 10 Sep 2026
            to still carry CVE-2026-59313 (Critical) plus a further 9 Critical
            and 13 High CVEs against spring-webmvc/-webflux/-web/-core/-beans/
            -expression specifically at that version. 7.0.9 is the version
            JFrog's own advisory names as containing the actual fix for
            CVE-2026-59313 - overriding here rather than waiting on a newer
            Boot 4.0.x parent release, since none was available to verify
            from this environment (no live Maven Central access). CONFIRM
            this override is still needed once a newer spring-boot-starter-parent
            patch version is confirmed to bundle >= 7.0.9 directly - at that
            point this override becomes redundant and should be removed rather
            than left as a second source of truth for the version.
        -->
        <spring-framework.version>7.0.9</spring-framework.version>
        <!--
            Same reasoning as spring-framework.version above - Checkmarx SCA scan
            (10 Sep 2026) confirmed each of these still at versions carrying
            Critical/High CVEs despite the Boot 4.0.0 upgrade:

            spring-security   7.0.0 -> CVE-2026-40993 (fixed <=7.0.5),
                                        CVE-2026-22746 (fixed <=7.0.4), plus others
                                        -> 7.0.6 clears all CVEs found in this scan
            tomcat             11.0.14 -> CVE-2026-53434/55276/55955 and 9 others,
                                        all fixed in 11.0.23

            jackson: NOT handled via a property here. A first attempt used a
            jackson-bom.version property set to 2.21.5, assuming it governed
            the classic com.fasterxml.jackson (2.x) coordinates - this was
            wrong. In Spring Boot 4.0, jackson-bom.version resolves against
            tools.jackson:jackson-bom (the 3.x line), and 2.21.5 is not a
            valid version under those coordinates, causing a build failure
            ("Non-resolvable import POM ... was not found"). Both the 2.x and
            3.x jackson lines are instead pinned explicitly, by exact
            dependency, in the dependencyManagement block below - see the
            comment there for the CVE detail and target versions.
        -->
        <spring-security.version>7.0.6</spring-security.version>
        <tomcat.version>11.0.23</tomcat.version>
        <!--
            Continuing the same pattern above - remaining Critical/High CVEs
            from the same 10 Sep 2026 Checkmarx scan, all resolved by version
            overrides:

            netty       4.2.7.Final -> multiple CVEs (LZ4 decompression bomb,
                                        TLS handshake CPU exhaustion, mTLS
                                        clientAuth bypass) all fixed by 4.2.17.Final
            micrometer  1.16.0      -> CVE-2026-40983/40984 (DoS via crafted
                                        gRPC/HTTP requests), fixed 1.16.6+
            logback     1.5.21      -> CVE-2026-13006 (arbitrary code execution
                                        via conditional config + Janino), affects
                                        "through 1.5.36" - needs 1.5.37+

            Same caveat as above: none of these could be verified against a
            live Maven repository from this environment. Confirm via
            `mvn dependency:tree` after building.
        -->
        <netty.version>4.2.17.Final</netty.version>
        <micrometer.version>1.16.6</micrometer.version>
        <logback.version>1.5.37</logback.version>
        <jacoco.version>0.8.11</jacoco.version>
        <!-- Vendored plumbing (see common/VENDORED.md) -->
        <nimbus.version>10.4.2</nimbus.version>
        <jedis.version>7.5.3</jedis.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <commons.lang3.version>3.18.0</commons.lang3.version>
        <jspecify.version>1.0.0</jspecify.version>
        <vault.driver.version>5.1.0</vault.driver.version>
        <!--
            REMOVED as part of the Spring Boot 4.0.0 upgrade (see parent above):
            commons-lang3.version, jackson-bom.version, log4j2.version,
            netty.version, and tomcat.version were all CVE-preemption pins
            written specifically against spring-boot-dependencies:3.5.16's
            own BOM-managed versions ("pick up patches released after 3.5.16
            itself"). That rationale no longer applies now the parent is a
            much newer major line — Boot 4.0 is expected to already manage
            current, patched versions of all five by default.

            Confirmed one is actively broken, not just stale: Boot 4.0's BOM
            resolves jackson-bom.version against tools.jackson:jackson-bom
            (Jackson's own groupId change), not com.fasterxml.jackson:jackson-bom
            that 2.21.6 was a valid version for — hence "Could not find
            artifact tools.jackson:jackson-bom:pom:2.21.6 in central".
            The other three (commons-lang3, log4j2, netty) were not
            confirmed broken the same way, but carry the same risk and
            could not be verified from this environment (no network access).

            ACTION REQUIRED once this builds cleanly: re-run JFrog/Checkmarx
            to check whether tomcat-embed, jackson, log4j2, netty, or
            commons-lang3 are still flagged under Boot 4.0's own defaults.
            If any still are, add a fresh override here using Boot 4.0's
            actual property name/coordinate for that library — do not
            reuse the values below, they are for the old BOM.
        -->
        <!-- OTEL telemetry — versions match dpn-federator's own pins -->
        <opentelemetry.version>1.63.0</opentelemetry.version>
        <opentelemetry.instrumentation.version>1.32.0-alpha</opentelemetry.instrumentation.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Jackson - both major lines pinned explicitly here, by exact
                dependency, rather than via a jackson-bom.version property.
                A first attempt used that property (set to a 2.x-style version)
                assuming it covered the classic com.fasterxml.jackson (2.x)
                coordinates - this broke the build, because in Spring Boot 4.0
                that property actually resolves against tools.jackson:jackson-bom
                (the 3.x line), where a 2.x-style version does not exist
                ("Non-resolvable import POM"). Pinning both lines directly
                avoids relying on a property name/behaviour that could not be
                confirmed from this environment (no live Maven Central access).

                tools.jackson.core (3.x)          3.0.2  -> 3.2.1
                com.fasterxml.jackson.core (2.x)  2.20.1 -> 2.21.5
                Both clear CVE-2026-77310 (DNS-based SSRF via eager
                InetAddress resolution) and CVE-2026-59888 (@JsonIgnore
                bypass on Records), found against the respective old versions
                in the 10 Sep 2026 Checkmarx scan.

                CONFIRM via `mvn dependency:tree | grep -i jackson` after
                building - both lines should show only these two versions,
                nothing older.
            -->
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>3.2.1</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>3.2.1</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.21.5</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.21.5</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
