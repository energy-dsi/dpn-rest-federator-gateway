<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        REST Federator Server — the gateway. A Spring Boot application deployed
        as a container.

        A generic authorising reverse proxy: it validates mTLS and the caller's
        JWT, verifies the consumer and its certificate status, checks the
        request's method and path against the product's DSM configuration, and
        forwards the authorised request verbatim to a configured backend.

        Shares configuration loading, mTLS, IDP token acquisition and Management
        Node communication with the client library via common/.
    -->

    <artifactId>rest-federator-server</artifactId>
    <packaging>jar</packaging>
    <name>DSI REST Federator — Server (Producer-side)</name>

    <description>
        Producer-side REST Federator. Standalone Spring Boot application.
        Generic authorizing reverse proxy: JWT validation, consumer
        verification, method+path authorisation, then forwards the
        authorized request to a configured backend. No business/example
        code — see the demo/ folder for a runnable example backend+client.
        Reuses federator-common utilities for token acquisition, mTLS,
        and Management Node communication.
    </description>

    <parent>
        <groupId>org.dsi.dpn</groupId>
        <artifactId>rest-federator-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <dependencies>

        <!-- ── Vendored DPN platform plumbing (see common/) ───────────── -->
        <!--
            Provides: GRPCUtils, PropertyUtil, SSLUtils,
            HttpClientFactoryUtils, ManagementNodeDataHandler,
            ProducerConfigService, InMemoryConfigurationStore,
            IdpTokenService + all implementations, all DTOs.
            Must be available in local Maven repo or artifact repository.
        -->
        <dependency>
            <groupId>org.dsi.dpn</groupId>
            <artifactId>rest-federator-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ── Spring Boot ───────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── OpenAPI / Swagger UI ──────────────────────────────────── -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ── Lombok ────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ── Test ──────────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>



        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>2.3.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>2.3.0</version>
        </dependency>

        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>5.2.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
