# Dockerfile for dpn-rest-federator-gateway (rest-federator-server)
#
# This is a Spring Boot repackaged ("fat") jar -- dependencies are
# nested inside BOOT-INF/lib/*.jar, so it MUST be launched with
# `java -jar`, not a flat -cp classpath.

FROM eclipse-temurin:21-jre AS rest-federator

# Full upgrade, not just openssl/libssl3t64 -- JFrog Xray flags CVEs across
# the base image's whole OS package set (util-linux, login, rust-coreutils,
# etc.), not only TLS libraries.
RUN apt-get update \
 && apt-get upgrade -y \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/ && \
	groupadd appgroup && \
	useradd -Mg appgroup rest-federator-service && \
	chown -R :appgroup /app/

WORKDIR /app
ARG JAR_NAME
COPY server/target/${JAR_NAME}.jar /app/app.jar
USER rest-federator-service

# Spring Boot repackaged jar -- must use -jar, not -cp.
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
